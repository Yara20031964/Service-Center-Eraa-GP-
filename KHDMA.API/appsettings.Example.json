// ---------------------------------------------------------------------------
// KHDMA API - example configuration
//
// Copy this file to `appsettings.json` and fill in the real values.
// `appsettings.json` is gitignored - never commit real secrets.
//
//     cp KHDMA.API/appsettings.Example.json KHDMA.API/appsettings.json
//
// The .NET JSON configuration provider allows comments and trailing commas,
// so this file works as-is once renamed.
// ---------------------------------------------------------------------------
{
  "ConnectionStrings": {
    // SQL Server. LocalDB example:
    //   "Server=(localdb)\\MSSQLLocalDB;Database=KHDMA;Trusted_Connection=True;MultipleActiveResultSets=true"
    // Migrations are applied automatically on startup (Program.cs).
    "DefaultConnection": ""
  },

  // Read by Program.cs (token validation) and AuthService (token generation).
  "Jwt": {
    // HMAC-SHA256 signing key. Must be at least 32 characters or startup throws.
    "Key": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "KHDMA",
    "Audience": "KHDMA.Client",
    // SRS 10.1: 15 minute access token, 30 day refresh token with rotation.
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30
  },

  // Public origin used to turn stored root-relative image paths into client URLs.
  // Leave blank to derive the origin from the current HTTP request.
  "App": {
    "PublicBaseUrl": ""
  },

  // Read by PaymobService. This is the SRS 6.1 gateway.
  "Paymob": {
    "BaseUrl": "https://accept.paymob.com/api",
    "ApiKey": "",
    "IntegrationId": "",
    "IframeId": "",
    // Used to verify webhook callback signatures - required in production.
    "HmacSecret": ""
  },

  // Read by StripePaymentService.
  // NOTE: Stripe is scheduled for removal in favour of Paymob.
  // See docs/IMPLEMENTATION_PLAN.md section 5.3.
  "StripeSettings": {
    "SecretKey": ""
  },

  // NOT CURRENTLY USED. LocalFileStorageService is registered instead, because
  // every BlobStorageService method still throws NotImplementedException.
  // Uploads land in wwwroot/uploads and are served as static files.
  // Left here for when Azure Blob is implemented and swapped back in Program.cs.
  "AzureBlobStorage": {
    "ConnectionString": "",
    "ContainerName": "khdma"
  },

  // ---------------------------------------------------------------------------
  // Real-time state: distributed locks, live locations, presence, dispatch
  // candidates - and the SignalR backplane.
  //
  // Enabled=false uses in-process implementations. Those are correct for ONE
  // instance only; with two or more, the first-accept guarantee breaks and
  // job cards reach only the providers sharing an instance with the dispatcher.
  // Leave it false for local development and the demo; turn it on to scale out.
  // ---------------------------------------------------------------------------
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379"
  },

  // Read by EtaProvider (Distance Matrix). Leave blank to fall back to a
  // straight-line estimate - the API still works, ETAs are just approximate
  // and report "source": "Haversine".
  "GoogleMaps": {
    "ApiKey": ""
  },

  // Read by PricingService. Rendered as the "VAT (10%)" line at checkout.
  // Commission is taken off the service fee, never off the VAT.
  "Vat": {
    "Rate": 0.10,
    "Currency": "EGP"
  },

  // Read by DispatchService and DispatchTimeoutWorker.
  // A booking is broadcast to every eligible provider inside InitialRadiusKm;
  // if nobody accepts within AcceptTimeoutSeconds the radius grows by
  // RadiusIncrementKm, up to MaxRounds rounds or MaxRadiusKm, then the booking
  // becomes NoProviderFound and the payment is refunded.
  "Dispatch": {
    "InitialRadiusKm": 10,
    "MaxRadiusKm": 30,
    "RadiusIncrementKm": 10,
    "AcceptTimeoutSeconds": 60,
    "MaxRounds": 3,
    "MaxProvidersPerRound": 20
  },

  // Read by LocalFileStorageService. SRS 10.3.
  "FileUpload": {
    "MaxSizeBytes": 10485760,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".pdf" ]
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
